#!/usr/bin/env node
/**
 * The `sprout` command entry point (#117).
 *
 * The only subcommand tree today is `sprout worker <command>`, which owns the
 * macOS Worker enrollment and signed-in-user LaunchAgent lifecycle. This file is
 * deliberately a thin dispatcher: the Worker CLI holds the behaviour and its own
 * process entry point, so no command logic lives here.
 */

import { main as workerMain } from '../src/worker/cli/worker-cli.ts';

const [, , command, ...rest] = process.argv;

switch (command) {
  case 'worker':
    process.exit(await workerMain(rest));
    break;
  case undefined:
  case 'help':
  case '--help':
  case '-h':
    process.stdout.write('Usage: sprout <command>\n\nCommands:\n  worker   Manage the macOS Environment Worker\n');
    process.exit(command === undefined ? 2 : 0);
    break;
  default:
    process.stderr.write(`sprout: unknown command "${command}"\n`);
    process.exit(2);
}
